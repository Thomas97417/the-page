VITE_CONVEX_URL=https://affable-ptarmigan-378.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://affable-ptarmigan-378.eu-west-1.convex.site

# PostHog EU : laisser le jeton vide pour désactiver le suivi.
# Seul le jeton public de projet (phc_...) peut être exposé au navigateur.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_ENVIRONMENT=development

# Secret du serveur d’authentification Cloudflare : binding privé du Worker.
# Requis aussi en dev avec le plugin Cloudflare. Le renseigner dans .env.local
# ou .dev.vars (fichiers privés ignorés par Git) ; voir README.md.
# Même valeur dans Convex. Ne jamais utiliser un nom VITE_* pour ce secret.
# AUTH_PROXY_SECRET=
