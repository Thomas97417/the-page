# Déploiement cloud de développement du projet the-page (équipe throuquette).
CONVEX_DEPLOYMENT=dev:affable-ptarmigan-378
CONVEX_URL=https://affable-ptarmigan-378.eu-west-1.convex.cloud
CONVEX_SITE_URL=https://affable-ptarmigan-378.eu-west-1.convex.site

# À définir dans le dashboard du déploiement Convex (pas seulement dans ce fichier).
# Dev : test + sk_test_… ; production : live + sk_live_…
# Clés et secrets de webhook distincts sur chaque déploiement.
# Ne jamais exposer ces valeurs au frontend.
# STRIPE_MODE=test
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SITE_URL=http://localhost:3003
# ADMIN_USER_IDS=

# PostHog EU : configurer dans les variables du déploiement Convex.
# Même jeton public de projet (phc_...) que dans VITE_POSTHOG_PROJECT_TOKEN.
# La variable doit exister dans Convex ; une valeur vide désactive les captures.
# Aucun secret PostHog n’est nécessaire. Voir la configuration dans README.md.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_ENVIRONMENT=development

# Signature de l’IP transmise par le serveur Cloudflare. Utiliser un secret dédié
# de 32 caractères minimum, partagé uniquement avec le binding privé du Worker.
# AUTH_PROXY_SECRET=
